dist/
node_modules/

# Real oslc-mcp-server configuration names a specific deployment and may
# carry literal credentials. The committed example is *.example.yaml.
oslc-mcp-server*.yaml
!oslc-mcp-server*.example.yaml

# The discovery report at its default path is a runtime artifact, rewritten on
# every start. To keep one as committed context, point `reportPath` at a
# deliberate location (e.g. docs/discovery-<deployment>.md) and commit that.
# Discovery reports — generated, rewritten on every server start. One per config:
# `reportPath` in each oslc-mcp-server*.yaml names its own file.
oslc-discovery*.md

# Stored OAuth refresh tokens. A refresh token lets this process act as the
# user who signed in, for as long as the issuer honours it — a live credential,
# never a committed one. Written 0600 beside the configuration that named the
# issuer.
.oslc-mcp-tokens.json
